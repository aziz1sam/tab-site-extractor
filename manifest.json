{
  "manifest_version": 3,
  "name": "فاصل التبويبات حسب الموقع",
  "short_name": "فاصل التبويبات",
  "version": "1.0.0",
  "description": "عرض التبويبات المفتوحة مجمّعة حسب الموقع ونقل المواقع المختارة إلى نافذة مستقلة مع الترتيب التلقائي أو إغلاقها.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "فاصل التبويبات حسب الموقع",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "فتح نافذة فاصل التبويبات"
    }
  }
}
